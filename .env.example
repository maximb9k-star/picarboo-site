# Домен сайта (без https://) и пароль базы — для docker compose
DOMAIN=picarboo.ru
POSTGRES_PASSWORD=
# Для запуска без Docker: адрес базы PostgreSQL
DATABASE_URL=postgres://picarboo:picarboo@localhost:5432/picarboo
# Адрес сайта (для ссылок в уведомлениях и Telegram Login)
SITE_URL=https://picarboo.ru
# Telegram-бот: токен от @BotFather, имя бота без @, и ваш chat_id, куда слать заявки
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
# Пароль входа в админку /admin
ADMIN_PASSWORD=
# Секрет для подписи cookie (любая длинная случайная строка)
SESSION_SECRET=
