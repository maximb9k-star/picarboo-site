# HTTPS-сертификаты Let's Encrypt выпускаются автоматически при первом заходе на домен,
# если сайт подтверждает, что домен разрешён (адрес по умолчанию и домены из админки).
{
	on_demand_tls {
		ask http://web:3000/api/tls-check
	}
}

https:// {
	tls {
		on_demand
	}
	encode gzip
	@www header_regexp host Host ^www\.(.+)$
	redir @www https://{re.host.1}{uri} permanent
	reverse_proxy web:3000
}

http:// {
	redir https://{host}{uri} permanent
}
